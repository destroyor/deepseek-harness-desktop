# Local Linux build settings (mirrors .env.windows.example, no signing needed).
DSH_DESKTOP_APP_ID=com.deepseek.harness
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=https://download-test.deepseek.com
# Required for test releases: 32 lowercase hexadecimal characters. This build never uploads, so it
# only has to satisfy the packaging preflight.
DOWNLOAD_TEST_RELEASE_ID=00000000000000000000000000000000

# The selected mandatory-update origin is required, including unsigned and preparation builds.
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://harness-test.deepseek.com
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://harness.deepseek.com
# Test deployments must name their approved login origins; the desktop shell still drops the policy
# from a Linux build, which has no policy service to talk to.
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://harness-test.deepseek.com"]}'